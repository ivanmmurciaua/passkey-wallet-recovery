# Pimlico API key (bundler + sponsored paymaster). Get one at https://dashboard.pimlico.io
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_key_here

# Network: sepolia (default) | baseSepolia | arbitrumSepolia. See src/app/constants.ts.
NEXT_PUBLIC_NETWORK=sepolia

# Optional: override the RecoveryModule address. By default the one registered for the
# active network in src/app/constants.ts is used (already deployed on Sepolia).
# NEXT_PUBLIC_RECOVERY_MODULE_ADDRESS=0x...

# Only to deploy RecoveryModule on a new network (npx hardhat run scripts/deploy.ts --network <key>).
# Needs testnet ETH on that network. NEVER COMMIT A REAL PRIVATE KEY.
# DEPLOYER_PRIVATE_KEY=0x...
